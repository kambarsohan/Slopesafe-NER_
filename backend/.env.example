# SlopeSafe NER backend — example environment file
# This prototype does not use any paid APIs or external services,
# so there are no real secrets here. This file exists only to show
# where you'd add configuration if the project grew in the future.

# Local SQLite database file (already the default in database.py)
DATABASE_URL=sqlite:///./slopesafe.db

# The frontend's local dev URL, used for CORS in main.py
FRONTEND_URL=http://localhost:5173
